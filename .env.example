# Copy this file to .env.local (development) and fill in the values.
# In production, set the same variables in your hosting dashboard (e.g. Vercel → Settings →
# Environment Variables) and redeploy. NEVER commit real keys.

# Public URL of the site, used in emails and payment redirects. No trailing slash.
APP_URL=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
# Local development, nothing to install (PGlite, saved in ./.data/pglite):
#   DATABASE_URL=pglite:./.data/pglite
# Production: a hosted PostgreSQL (Neon, Supabase, Vercel Postgres...) with sslmode=require:
#   DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=pglite:./.data/pglite

# ---------- Stripe (card payments) ----------
# Dashboard → Developers → API keys. Use sk_test_... until you're ready to go live.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → add endpoint https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints a whsec_ secret.
STRIPE_WEBHOOK_SECRET=

# ---------- Bank transfer (optional) ----------
# Leave empty to hide the bank transfer option. Shown to the customer and emailed with the order.
# Use \n for new lines, for example:
# BANK_TRANSFER_INSTRUCTIONS="Bank: Example Bank\nAccount name: STN IT Enterprise LLC\nAccount: 000000000\nRouting: 000000000"
BANK_TRANSFER_INSTRUCTIONS=

# ---------- Email (Resend: https://resend.com) ----------
# Verify your domain in Resend first, then send from an address on that domain.
RESEND_API_KEY=
EMAIL_FROM="STN IT Enterprise <orders@stnitenterprise.com>"
# Where new orders, contact messages and quote requests are sent.
NOTIFY_EMAIL=sales@stnitenterprise.com

# ---------- Sign in with Google (optional) ----------
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application.
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
# (e.g. https://stn-it-enterprises.vercel.app/api/auth/google/callback and http://localhost:3000/api/auth/google/callback)
# The "Continue with Google" button only appears when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Admin access ----------
# Comma-separated emails that get /admin OWNER access once they sign in WITH GOOGLE (Google proves
# the address belongs to them; email+password sign-up does not). Needs GOOGLE_CLIENT_ID/SECRET.
# Without Google, use `npm run make-admin -- you@example.com` instead. Everyone else is invited
# from /admin/team.
ADMIN_EMAILS=

# ---------- Live chat (optional, tawk.to) ----------
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=default
